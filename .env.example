# Google Cloud Console > APIs & Services > Credentials
# Create an OAuth 2.0 Client ID of type "Desktop app".
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/callback

# Firebase Console > Project settings > General > "SDK setup and configuration"
# Only FIREBASE_API_KEY is actually used (for the signInWithIdp / token refresh
# REST calls) — the rest can be pasted as-is from the console for reference.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
